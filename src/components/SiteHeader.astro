---
const title = Astro.props.title ?? 'WOW AR Tour';
---
<header class="header">
  <div class="container header__row">
    <a class="brand" href="/tour/" aria-label="What Once Was tour home">
      <span class="brand__wow">WOW</span>
      <span class="brand__name">What Once Was</span>
    </a>
    <div class="header__right">
      <span class="kicker">Austin, Texas</span>
    </div>
  </div>
</header>
<style>
  .header{position:sticky;top:0;z-index:50;background:rgba(246,240,227,.94);backdrop-filter:blur(12px);border-bottom:1px solid rgba(36,31,26,.16)}
  .header__row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 0}
  .brand{display:flex;align-items:center;gap:11px;color:#251f1a;text-decoration:none;text-transform:uppercase}
  .brand__wow{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#b5271e;color:#fff;font-size:.82rem;font-weight:900;letter-spacing:-.06em}
  .brand__name{font-size:.86rem;font-weight:800;letter-spacing:.17em}
  .kicker{font-size:.68rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#756b60}
  @media (max-width:520px){.brand__name{font-size:.72rem;letter-spacing:.11em}.kicker{display:none}}
</style>
